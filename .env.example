# TechAvenue — environment variables
# Copy this file to .env.local and fill in the values. NEVER commit real values.
# .env.local (and every .env* except this example) is gitignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# --- ONVO Pay ---
ONVO_SECRET_KEY=
ONVO_WEBHOOK_SECRET=
# Set to "true" to show the card-payment option in checkout
NEXT_PUBLIC_ONVO_HABILITADO=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- Admin / auth ---
ADMIN_PASSWORD=
ADMIN_SECRET=

# --- Cron ---
CRON_SECRET=

# --- External catalog (Divia) ---
CATALOGO_EXTERNO_URL=
CATALOGO_EXTERNO_USER=
CATALOGO_EXTERNO_PASS=
